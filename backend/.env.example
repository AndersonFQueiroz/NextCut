# Configuração do Banco de Dados PostgreSQL (Supabase)
# O formato esperado inclui a porta, nome do banco, usuário e senha na query string.
# Exemplo para Supabase Pooler (transaction mode):
DATABASE_URL=jdbc:postgresql://<aws-region>.pooler.supabase.com:5432/postgres?user=postgres.<project-ref>&password=<sua_senha>&sslmode=require

# Porta em que a aplicação vai rodar localmente
PORT=8080

# Integração WhatsApp (Evolution API / Z-API / WPPConnect REST)
# Se as variáveis abaixo não forem definidas, o sistema vai apenas imprimir o código OTP no terminal (Modo Dev).
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=sua_apikey_global
EVOLUTION_INSTANCE=NextCut
