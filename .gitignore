# ==========================================
# NextCut Root GitIgnore
# ==========================================

# OS Metadata
.DS_Store
Thumbs.db
*.ico

# IDEs and Text Editors
.idea/
*.iml
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project
.factorypath
.metadata/
.recommenders/
*~
*.swp
*.swo

# AI / Agent Tools
.agents/
.cursor/
.antigravitycli/

# Environment and Secrets (Never commit credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example

# Node / Frontend Build & Cache
node_modules/
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/coverage/
.eslintcache
*.tsbuildinfo

# Java / Maven Build & Output
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.m2/
dependency-reduced-pom.xml
release.properties

# Logs
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Planejamento e Notas (Privado - NUNCA COMMITAR)
planejamento*.*
nota_professor*.*
criterio*.*
issuemuginski*.*
erro*.*
*.png
*.jpg
*.jpeg
*.gif

# Exceções para imagens e assets do projeto
!**/assets/**/*.png
!**/assets/**/*.jpg
!**/assets/**/*.jpeg
!**/assets/**/*.gif

# Arquivos de ambiente
.env
.env.local
.env.*.local
.env.production

# Dependencias
node_modules/
**/node_modules/

# Build do frontend
frontend/dist/
frontend/.vite/

# Build do backend
backend/target/

# Logs
*.log
npm-debug.log*
vite-dev.out.log

# Arquivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.iml

# Imagens avulsas na raiz ou em docs/
/*.png
/*.jpg
/*.jpeg
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg

# Arquivos temporarios
*.tmp
*.bak
*.swp
